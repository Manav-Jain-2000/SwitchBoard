# Required API Keys
FIREWORKS_API_KEY=fw_...       # Fireworks AI (embeddings)
GROQ_API_KEY=gsk_...           # Groq (Llama 3.1 + Kimi K2)
CEREBRAS_API_KEY=csk-...       # Cerebras (classifier + GPT-OSS + Qwen 235B)
GEMINI_API_KEY=...             # Google Gemini (judge + aggregator)
OPENAI_API_KEY=sk-...          # OpenAI (GPT-4o for code escalation)
OPENROUTER_API_KEY=sk-or-...   # OpenRouter (Claude Opus for escalation)

# Optional
LANGSMITH_API_KEY=lsv2_...     # LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=switchboard
GPT5_BASELINE_COST=0.012       # Baseline cost per query for savings calculation
